# Optional. Copy to .env (and load it however your host expects — e.g. `export $(cat .env)`,
# or your platform's env var UI) to add a TURN relay for restrictive networks where a direct
# peer-to-peer connection can't be established via STUN alone (some corporate NATs, symmetric
# NATs, etc). Not required for the app to work on the vast majority of home/office networks.
PORT=3001
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_CREDENTIAL=
